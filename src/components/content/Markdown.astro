---
interface Props {
	class: string;
	lang?: string;
}
const className = Astro.props.class;
---
<div lang={Astro.props.lang?.replace("_", "-")} data-pagefind-body class={`prose dark:prose-invert prose-base !max-w-none custom-md markdown-content ${className}`}>
	<slot />
</div>

<style lang="stylus" is:global>
@import "../../styles/markdown/generic.styl"
</style>

<script>
	import { bindMarkdownRuntime } from "@utils/markdown-runtime";

	bindMarkdownRuntime();
</script>
